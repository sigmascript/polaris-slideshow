{
  "name": "polaris-slideshow",
  "version": "1.7.0",
  "description": "Polaris Slideshow Plugin for Polaris Framework. A responsive JavaScript slideshow for HTML elements.",
  "author": "Hemin Satya",
  "license": "MIT",
  "main": "index.js",
  "style": "/dist/css/main.css",
  "sass": "/src/scss/main.scss",
  "javascript": "/dist/js/main.js",
  "typescript": "/src/ts/main.ts",
  "types": "/dist/js/main.d.ts",
  "module": "/dist/js/modules/Slideshow.js",
  "keywords": [
    "CSS",
    "Sass",
    "JavaScript",
    "TypeScript",
    "webpack",
    "HTML",
    "responsive-design",
    "front-end",
    "Web",
    "Framework"
  ],
  "homepage": "https://github.com/sigmascript/polaris-slideshow#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sigmascript/polaris-slideshow.git"
  },
  "bugs": {
    "url": "https://github.com/sigmascript/polaris-slideshow/issues"
  },
  "devDependencies": {
    "polaris-core": "1.0.6",
    "polaris-colors": "^1.5.1",
    "sass": "1.105.2",
    "typescript": "5.9.3",
    "webpack": "5.112.0",
    "webpack-cli": "5.1.4",
    "ts-loader": "9.6.2",
    "inspectpack": "4.7.1",
    "@types/node": "18.19.0"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "css": "sass src/scss/main.scss dist/css/main.min.css --style compressed --load-path=node_modules --no-source-map --silence-deprecation=import,global-builtin,if-function",
    "css-dev": "sass src/scss/main.scss dist/css/main.css --watch --load-path=node_modules --silence-deprecation=import,global-builtin,if-function",
    "css-rtl": "sass src/scss/main-rtl.scss dist/css/main-rtl.min.css --style compressed --load-path=node_modules --no-source-map --silence-deprecation=import,global-builtin,if-function",
    "css-rtl-dev": "sass src/scss/main-rtl.scss dist/css/main-rtl.css --watch --load-path=node_modules --silence-deprecation=import,global-builtin,if-function",
    "js-mod": "tsc --watch",
    "js": "webpack",
    "js-dev": "webpack --config webpack.config.dev.js"
  }
}
